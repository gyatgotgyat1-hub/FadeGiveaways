# Secret phrase typed key-by-key to unlock admin panel (default: adminpanel)
ADMIN_PANEL_SECRET=adminpanel

# Upstash Redis — create free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY=
EMAIL_FROM=FadeGiveaways <onboarding@resend.dev>

# Your live site URL (no trailing slash) — used in verification links
SITE_URL=http://localhost:3000

# Random string to sign admin cookies (generate: openssl rand -hex 32)
ADMIN_COOKIE_SECRET=change-me-to-a-long-random-string
