# Upstash Redis — required for accounts & giveaways to persist
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs login tokens (generate: openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string

# Resend — https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY=
EMAIL_FROM=FadeGiveaways <onboarding@resend.dev>

# Your live site URL (no trailing slash) — used in verification links
SITE_URL=http://localhost:3000

# Random string (optional legacy)
ADMIN_COOKIE_SECRET=change-me-to-a-long-random-string
